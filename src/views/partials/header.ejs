<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="csrf-token" content="<%= csrf %>">
<title>
<%= title %> · PeopleFlow</title>
<link rel="stylesheet" href="/css/app.css">
<script src="/js/app.js" defer>
</script>
<script src="/socket.io/socket.io.js" defer>
</script>
<script src="/js/realtime.js" defer>
</script>
</head>
<body>
<aside class="sidebar">
<a href="/" class="brand">
<span class="brand-mark">p<span>f</span>
</span>PeopleFlow<span class="brand-dot">®</span>
</a>
<div class="workspace">
<span class="workspace-avatar">P</span>
<div><%= user.company?.name||'PeopleFlow' %><small>Quản trị nhân sự</small>
</div>
<span>⌄</span>
</div>
<div class="nav-label">KHÔNG GIAN LÀM VIỆC</div>
<nav aria-label="Điều hướng chính">
<% const items=[
['dashboard','/','◫','Tổng quan','dashboard.view'],
['employees','/employees/list','♙','Nhân viên','employees.view'],
['departments','/departments/list','▦','Phòng ban','departments.view'],
['companies','/companies/list','▦','Công ty','companies.view'],
['access','/access/list','⚿','Chức vụ & phân quyền','access.manage'],
['attendance','/attendance/list','◷','Chấm công','attendance.view'],
['leaves','/leaves/list','▣','Nghỉ phép','leaves.view'],
['notifications','/notifications/list','♧','Thông báo',null],
['audit','/audit/list','≡','Nhật ký thay đổi','audit.view'],
['system','/system/status','⚙','Hệ thống','system.view']
].filter(item=>!item[4]||can(item[4])).filter(item=>item[0]!=='access'||user.role==='admin'); %>
<% for(const [key,url,icon,label] of items){ %>
<a href="<%= url %>" class="nav-item <%= active===key?'selected':'' %>" <%- active===key?'aria-current="page"':'' %>>
<span class="nav-icon">
<%= icon %>
</span>
<%= label %>
</a>
<% } %>
</nav>
<div class="sidebar-note">
<span class="dot">
</span> Con người là trọng tâm<p>Một nơi cho mọi kết nối<br>trong đội ngũ của bạn.</p>
</div>
<div class="sidebar-user">
<span class="avatar">
<%= user.name.split(' ').slice(-2).map(s=>s[0]).join('') %>
</span>
<div>
<strong>
<%= user.name %>
</strong>
<small>
<%= user.roleName||user.role %>
</small>
</div>
<button class="icon-button" id="logout" title="Đăng xuất" aria-label="Đăng xuất">↪</button>
</div>
</aside>
<div class="main-shell">
<header class="topbar">
<div class="breadcrumb">Không gian làm việc <span>/</span> <strong>
<%= title %>
</strong>
</div>
<div class="topbar-right">
<span id="live-status" class="live-status">Đang kết nối</span>
<a class="notification-link" href="/notifications/list" aria-label="Thông báo">♧</a>
<span class="avatar small">
<%= user.name.split(' ').slice(-1)[0][0] %>
</span>
</div>
</header>
<main>
<div id="toast" class="toast" role="status" hidden>
</div>
